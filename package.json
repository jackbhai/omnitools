{
  "name": "omnitools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run verify:data && npm run verify:bus && npm run verify:metro && npm run verify:trip && npm run verify:render && npm run verify:smoke",
    "verify:data": "python3 scripts/verify_transit_data.py --pages 8 --osrm 6",
    "verify:bus": "node --experimental-loader ./scripts/_json_loader.mjs scripts/verify_bus.mjs",
    "verify:metro": "node --experimental-loader ./scripts/_json_loader.mjs scripts/verify_metro.mjs",
    "verify:trip": "node --experimental-loader ./scripts/_json_loader.mjs scripts/verify_trip.mjs",
    "verify:render": "vite build --ssr scripts/ssr-smoke.jsx --outDir .ssr-smoke --emptyOutDir && node .ssr-smoke/ssr-smoke.js",
    "verify:smoke": "node --experimental-loader ./scripts/_smoke_loader.mjs scripts/verify_smoke.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@vitejs/plugin-react": "^6.1.0",
    "astronomy-engine": "^2.1.19",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satellite.js": "^5.0.0",
    "vite": "^8.2.2"
  }
}